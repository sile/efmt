{
  "name": "efmt",
  "displayName": "efmt",
  "publisher": "sile",
  "license": "MIT",
  "description": "Erlang Code Formatter",
  "version": "0.21.0",
  "engines": {
    "vscode": "^1.77.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "erlang",
    "formatter"
  ],
  "bugs": {
    "url": "https://github.com/sile/efmt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sile/efmt"
  },
  "homepage": "https://github.com/sile/efmt/blob/main/README.md",
  "icon": "images/icon.png",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:erlang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "erlang",
        "aliases": [
          "Erlang"
        ],
        "extensions": [
          ".erl",
          ".escript"
        ],
        "filenames": [
          "rebar.config"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/vscode": "^1.77.0",
    "typescript": "^4.9.5",
    "ts-loader": "^9.4.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.0.1"
  }
}
